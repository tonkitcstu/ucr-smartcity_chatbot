# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง
#
#     cp .env.example .env
#
# .env ไม่ขึ้น git (ดู .gitignore) ไฟล์นี้ขึ้น — **ห้ามเผลอใส่ค่าจริงลงไฟล์นี้**


# --- AI (Gemini ผ่านช่องทางที่พูดภาษา OpenAI) ---
# key ของ Google AI Studio ตัวเดียวกับที่ใช้กับ REST ดั้งเดิมได้เลย
API_KEY=
#
# **ต้องเป็น base ที่ลงท้าย /v1beta/openai/ เท่านั้น**
# ไม่ใช่ URL เต็มแบบ .../v1beta/models/gemini-flash-latest:generateContent
# อันหลังคือ REST ดั้งเดิมของ Google ซึ่งรูปร่างข้อความคนละแบบกับที่ไลบรารีนี้พูด
# ใส่ผิดเป็นอันนั้นจะได้ 404 ตอนยิงจริง
#
# เว้นว่างได้ config.py ใส่ค่านี้เป็น default ให้อยู่แล้ว
API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/


# --- LINE ---
# ทั้งสองค่าเอาจาก LINE Developers Console > ช่อง Messaging API ของ OA
# secret ใช้ตรวจลายเซ็น webhook / token ใช้ยิงข้อความกลับ
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=


# --- Redis (บทสนทนาที่ยังคุยค้าง ของชั่วคราว) ---
# ไม่ตั้งก็ได้ โค้ดใช้ค่านี้เป็น default อยู่แล้ว
REDIS_URL=redis://localhost:6379/0


# --- broadcast (เราเป็นฝ่ายทักก่อน) ---
# ปิดอยู่ถ้าไม่ตั้ง — ตั้งเป็น true เมื่อพร้อมยิงหาชาวบ้านจริงเท่านั้น
# ปิดอยู่ยังกดลองเปล่า ๆ ได้ (POST /api/broadcast/run?dry=true) มันไม่ส่งอะไรออกไป
BROADCAST_ENABLED=false


# --- ล็อกประตู (issue #139) ---
#
# **ไม่ตั้งสักตัวข้างล่างนี้ = /dashboard กับ /api/* ปิดสนิท ตอบ 503**
# ตั้งใจ — ค่าตั้งต้นที่ปลอดภัยคือ "เข้าไม่ได้" ไม่ใช่ "ใครก็เข้าได้"
# (LINE webhook ไม่เกี่ยวกับบล็อกนี้ บอทเดินต่อเสมอ ตรวจด้วยลายเซ็นของ LINE อยู่แล้ว)

# รหัสสำหรับหน้าเว็บสองหน้าของเราเอง — เบราว์เซอร์จะเด้งช่องให้กรอกเอง
# ตั้งอะไรก็ได้ที่เดายาก **หนึ่งรหัสใช้ร่วมกันทั้งทีม ไม่ได้แยกรายคน**
DASHBOARD_USER=ucr
DASHBOARD_PASSWORD=

# กุญแจของ JWT ที่ทีมแดชบอร์ดออกให้ **เราเป็นฝ่ายตรวจ ไม่ได้เป็นคนออก**
# ต้องเป็นค่าเดียวกับที่ backend ของเขาใช้เซ็น ไม่งั้นแกะไม่ออก — ขอจากเขา
# ชื่อสองตัวนี้ตรงกับของเดิมบน branch main ตั้งใจ เขาจะได้เรียกแบบเดิมได้เลย
SECRET_KEY=
ALGORITHM=HS256

# origin ของหน้าเว็บทีมแดชบอร์ด คั่นด้วยจุลภาค ไม่ตั้งก็ใช้ค่าใน config.py
# (localhost:4200, 127.0.0.1:4200, dev-ucr-dashboard.m3chok.com)
CORS_ORIGINS=

# **ประตูที่กว้างที่สุด ห้ามเปิดบน prod** — api/dev.py + /docs + /openapi.json
# ข้างในดึงใบทั้งตารางพร้อมพิกัดบ้าน ล้างใบที่คนกำลังเล่าค้าง และเผา quota ได้ฟรี
DEV_ROUTES_ENABLED=false


# --- Postgres (รายงานที่ปิดใบแล้ว ของถาวร) ---
# ต้องเป็น instance ที่เปิด PostGIS ได้ เพราะเก็บพิกัดเป็น geography(Point, 4326)
DATABASE_URL=postgresql://user:password@localhost:5432/ucr

# --- โควตา (กันคนเดียวหรือ retry loop เดียวดูดจนบอทเงียบทั้งชุมชน) ---
#
# เว้นว่างได้ทั้งบล็อก config.py มี default ให้ครบแล้ว
# **วัดของจริงแล้ว 8 ส.ค. 69**: หนึ่ง call ~8,700 token (นิ่งมาก ไม่ขยับตามประวัติ)
# หนึ่งตา = 2 call · หนึ่งใบเต็ม ~11 call / ~95,000 token
# ค่าข้างล่างตั้งไว้ที่ ~200 ใบต่อวัน ที่มาของทุกตัวเลขอยู่ใน app/core/config.py
#
# จะจำกัดด้วยอะไร: both | tokens | requests | off
#   both      นับทั้งสองอย่าง เอาตัวที่ชนก่อน (ค่าตั้งต้น)
#   tokens    ใช้ตอนเปิด billing แล้ว — ตัวที่มีความหมายคือค่าใช้จ่าย
#   requests  ใช้ตอนยังเป็น key ฟรี — ตัวที่ชนคือ RPD
#   off       เครื่อง dev เท่านั้น **ห้ามใช้บน prod**
QUOTA_LIMIT_BY=both

# หน้าต่างสั้นของระบบ 6 เพราะ 24 หารลงตัว รีเซ็ต 00/06/12/18 เวลาไทย
# มีไว้กันไม่ให้ "งบหมดตอน 9 โมง แล้วเงียบยาวถึงเที่ยงคืน"
QUOTA_WINDOW_HOURS=6

# ระบบ — จำนวน request (หนึ่งตาของบทสนทนา = 1–4 request)
QUOTA_DAY_CALLS=2500
QUOTA_WINDOW_CALLS=900

# ระบบ — token (เลขจริงจาก usage ที่โมเดลส่งกลับมา)
QUOTA_DAY_TOKENS=22000000
QUOTA_WINDOW_TOKENS=8000000

# งบที่กันไว้ให้ "คนที่เล่าค้างอยู่" เล่าจนจบ = ระยะจากเหลืองถึงแดง
# ตั้งเป็นจำนวนที่เหลือ ไม่ใช่ % เพราะมันขึ้นกับจำนวนคนที่กำลังเล่าค้าง
# ไม่ได้ขึ้นกับว่าเพดานใหญ่แค่ไหน — ตั้งน้อยไปโซนเหลืองจะกลายเป็นคำโกหก
# ที่มา: 8 คนค้าง × 8 ตา × 2 call = 128 call ≈ 1.3M token
QUOTA_YELLOW_CALLS=150
QUOTA_YELLOW_TOKENS=1300000

# ต่อคน — **นับเป็นตา ไม่ใช่ token** ชาวบ้านคุมไม่ได้ว่าตาเขากิน token เท่าไหร่
QUOTA_USER_TURNS=60
QUOTA_USER_YELLOW_TURNS=45

# คนเดียวยิงรัว (คนละเรื่องกับ services/burst.py ที่รวมรูปหลายใบ)
QUOTA_RUSH_TURNS=15
QUOTA_RUSH_SECONDS=300

# ต่อใบ — อยู่นอกระบบโซน ตั้งใจ เพราะ retry loop คือ "คนที่เล่าค้างอยู่" พอดี
QUOTA_DRAFT_TURNS=40


# --- โมเดลคิดหนักแค่ไหน: low | medium | high ---
# วัดแล้ว: low ประหยัดกว่า high 18% และเร็วกว่า 2.9 เท่า โดยยังไม่เห็นว่าโง่ลง
# (เก็บข้อมูลครบ 8/8 ช่องเท่ากัน และไม่ปั้นเรื่องเพิ่มเหมือนกันทั้งสามระดับ)
# ตั้งต้นเป็น high ไว้ก่อน เพราะวัดมาแค่บทสนทนาละรอบเดียว — ลอง low ได้โดยไม่ต้องแก้โค้ด
REASONING_EFFORT=high
