# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง
#
#     cp .env.example .env
#
# .env ไม่ขึ้น git (ดู .gitignore) ไฟล์นี้ขึ้น — ห้ามใส่ค่าจริงลงไฟล์นี้
# ทุก key ในไฟล์นี้คือตัวที่ app/core/config.py อ่าน และมีเส้นใช้จริง
# ยกเว้นกลุ่มสุดท้าย (docker compose) ที่ docker-compose.yml เป็นคนอ่าน


# --- PostgreSQL (ของถาวร: ผู้แจ้ง ใบ ข้อความ รายงาน) ---
# ต้องตั้ง — ไม่มีค่าตั้งต้น
# สร้างตารางครั้งแรกด้วย: psql <ชื่อฐาน> -f schema.sql
DATABASE_URL=postgresql://user:password@localhost:5432/ucr-chat-v2-alpha


# --- Redis (ของชั่วคราว: ข้อความที่ยังไม่ตอบ state ของใบ คิวงาน) ---
# ไม่ตั้ง = ใช้ค่านี้
REDIS_URL=redis://localhost:6379/0


# --- LINE ---
# เอาจาก LINE Developers Console > ช่อง Messaging API
# secret ใช้ตรวจลายเซ็นของ webhook · token ใช้ตอบข้อความและดาวน์โหลดรูป
# ตอนพัฒนาใช้ช่องทดสอบ ไม่ใช่ช่องจริง
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=


# --- AI (Gemini ผ่านช่องทางที่รับรูปแบบ OpenAI) ---
# key จาก Google AI Studio
GEMINI_API_KEY=
# ต้องเป็น base ที่ลงท้าย /v1beta/openai/ · ไม่ตั้ง = ใช้ค่านี้
API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/


# --- แดชบอร์ด (3 เส้นใต้ /api/dashboard) ---
# กุญแจของ JWT ที่ backend ของทีมออกแบบใช้เซ็น — เราเป็นฝ่ายตรวจ ไม่ได้ออก token เอง
# ต้องเป็นค่าเดียวกับของเขา · ไม่ตั้ง = 3 เส้นนี้ตอบ 503 (บอทยังคุยได้ตามปกติ)
SECRET_KEY=
ALGORITHM=HS256


# --- worker และ sweeper (รันอยู่ใน process เดียวกับแอป) ---
# false = ไม่เปิดทั้งคู่ บอทรับข้อความแต่ไม่ตอบ และไม่ปิดใบ · ไม่ตั้ง = true
WORKER_ENABLED=true
# ผู้แจ้งเงียบกี่วินาที บอทถึงเริ่มตอบ (ข้อความที่มาติดกันถูกรวมตอบครั้งเดียว)
SILENCE_SECONDS=3
# ใบเงียบเกินกี่นาทีถึงปิดแล้วส่งไปทำรายงาน
CLOSE_AFTER_MINUTES=120
# sweeper ตรวจหาใบที่เงียบทุกกี่วินาที
SWEEP_EVERY_SECONDS=60


# --- รูปที่ผู้แจ้งส่งมา ---
# โฟลเดอร์ที่เก็บไฟล์รูป · ไม่ตั้ง = uploads/ ในราก repo
UPLOADS_DIR=


# --- เฉพาะตอนรันด้วย docker compose ---
# รหัสของ PostgreSQL ใน container — ใช้ตอนสร้างฐานครั้งแรกเท่านั้น แก้ทีหลังไม่มีผลกับฐานที่สร้างแล้ว
# ใช้ตัวอักษรอังกฤษกับตัวเลข ห้ามมี @ : / # เพราะถูกนำไปต่อเป็น DATABASE_URL
# DATABASE_URL กับ REDIS_URL ข้างบนไม่ถูกใช้ตอนรันด้วย compose (compose ใส่ค่าของมันเอง)
POSTGRES_PASSWORD=
# port ของเครื่องที่ชี้เข้าแอป · ไม่ตั้ง = 8000
APP_PORT=8000
