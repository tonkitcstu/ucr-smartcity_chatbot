# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง
#
#     cp .env.example .env
#
# .env ไม่ขึ้น git (ดู .gitignore) ไฟล์นี้ขึ้น — **ห้ามเผลอใส่ค่าจริงลงไฟล์นี้**


# --- AI (Gemini ผ่านช่องทางที่พูดภาษา OpenAI) ---
# key ของ Google AI Studio ตัวเดียวกับที่ใช้กับ REST ดั้งเดิมได้เลย
API_KEY=
#
# **ต้องเป็น base ที่ลงท้าย /v1beta/openai/ เท่านั้น**
# ไม่ใช่ URL เต็มแบบ .../v1beta/models/gemini-flash-latest:generateContent
# อันหลังคือ REST ดั้งเดิมของ Google ซึ่งรูปร่างข้อความคนละแบบกับที่ไลบรารีนี้พูด
# ใส่ผิดเป็นอันนั้นจะได้ 404 ตอนยิงจริง
#
# เว้นว่างได้ config.py ใส่ค่านี้เป็น default ให้อยู่แล้ว
API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/


# --- LINE ---
# ทั้งสองค่าเอาจาก LINE Developers Console > ช่อง Messaging API ของ OA
# secret ใช้ตรวจลายเซ็น webhook / token ใช้ยิงข้อความกลับ
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=


# --- Redis (บทสนทนาที่ยังคุยค้าง ของชั่วคราว) ---
# ไม่ตั้งก็ได้ โค้ดใช้ค่านี้เป็น default อยู่แล้ว
REDIS_URL=redis://localhost:6379/0


# --- broadcast (เราเป็นฝ่ายทักก่อน) ---
# ปิดอยู่ถ้าไม่ตั้ง — ตั้งเป็น true เมื่อพร้อมยิงหาชาวบ้านจริงเท่านั้น
# ปิดอยู่ยังกดลองเปล่า ๆ ได้ (POST /api/broadcast/run?dry=true) มันไม่ส่งอะไรออกไป
BROADCAST_ENABLED=false


# --- Postgres (รายงานที่ปิดใบแล้ว ของถาวร) ---
# ต้องเป็น instance ที่เปิด PostGIS ได้ เพราะเก็บพิกัดเป็น geography(Point, 4326)
DATABASE_URL=postgresql://user:password@localhost:5432/ucr


# --- โมเดลคิดหนักแค่ไหน: low | medium | high ---
# วัดแล้ว: low ประหยัดกว่า high 18% และเร็วกว่า 2.9 เท่า โดยยังไม่เห็นว่าโง่ลง
# (เก็บข้อมูลครบ 8/8 ช่องเท่ากัน และไม่ปั้นเรื่องเพิ่มเหมือนกันทั้งสามระดับ)
# ตั้งต้นเป็น high ไว้ก่อน เพราะวัดมาแค่บทสนทนาละรอบเดียว — ลอง low ได้โดยไม่ต้องแก้โค้ด
REASONING_EFFORT=high
