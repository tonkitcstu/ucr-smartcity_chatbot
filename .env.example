# Copy to .env, then fill in: cp .env.example .env
# Put real values only in .env. Every key and its default: docs/setup.md

# LINE Developers Console > your channel > Messaging API
# Use a test channel while you develop
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google AI Studio
GEMINI_API_KEY=

# Key the dashboard sends. Empty: every /api/dashboard route gives 503
# Make one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_KEY=

# Docker: database password, used once when the database is first made
# Letters and numbers only
POSTGRES_PASSWORD=

# Without Docker: your own PostgreSQL. Docker sets its own
DATABASE_URL=postgresql://user:password@localhost:5432/ucr-chat-v2-alpha

# Broadcast: bot messages up to 10 random reporters first every day
BROADCAST_ENABLED=false
# Daily forecast file, {date} becomes YYYY-MM-DD. Empty: mock forecast with rain every day
FORECAST_URL=
