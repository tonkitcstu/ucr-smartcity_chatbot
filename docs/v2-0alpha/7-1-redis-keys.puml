  {"line_event_id": "ev-1",
   "line_message_id": "m-1",
   "reply_token": "rt-text",
   "type": "text",
   "content": "The street floods every time it rains",
   "message_id": "ba6e2ee6-1396-4f60-9763-646abb1ea87d",
   "session_id": "93188814-7809-452c-b2b2-6b9fe569f940"}
  </code>
  type = "text" | "image" . image: content is null
end note

note bottom of LAST
